# Embedding provider defaults
RAG_EMBEDDING_PRIMARY__NAME=openai
RAG_EMBEDDING_PRIMARY__MODEL=text-embedding-3-small
# RAG_EMBEDDING_PRIMARY__API_KEY=
# RAG_EMBEDDING_PRIMARY__ENDPOINT=https://api.openai.com/v1/embeddings
RAG_EMBEDDING_PRIMARY__TIMEOUT_SECONDS=15
RAG_EMBEDDING_PRIMARY__MAX_PARALLEL_REQUESTS=4
RAG_EMBEDDING_PRIMARY__MAX_TOKENS_PER_MINUTE=60000
RAG_EMBEDDING_PRIMARY__CACHE_ENABLED=true
RAG_EMBEDDING_PRIMARY__ENABLED=true

# Optional fallback
# RAG_EMBEDDING_FALLBACK__NAME=azure-openai
# RAG_EMBEDDING_FALLBACK__MODEL=text-embedding-3-large
# RAG_EMBEDDING_FALLBACK__API_KEY=
# RAG_EMBEDDING_FALLBACK__ENDPOINT=
# RAG_EMBEDDING_FALLBACK__ENABLED=true
