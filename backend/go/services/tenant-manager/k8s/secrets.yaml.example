# IMPORTANT: This is an example file. Do not commit actual secrets!
# Copy this file to secrets.yaml and fill in the actual values.
# Add secrets.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: tenant-manager-secrets
  namespace: serphona
  labels:
    app: tenant-manager
    component: backend
type: Opaque
stringData:
  # Database credentials (base64 encoded in production)
  database-host: "postgresql.database.svc.cluster.local"
  database-name: "tenants"
  database-user: "tenant_manager"
  database-password: "CHANGE_ME_STRONG_PASSWORD"
  
  # Redis URL
  redis-url: "redis://redis-master.redis.svc.cluster.local:6379/0"
  
  # JWT Secret for authentication
  jwt-secret: "CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE"
  
  # Optional: Stripe API key
  stripe-api-key: ""
  
  # Optional: SendGrid API key for emails
  sendgrid-api-key: ""
