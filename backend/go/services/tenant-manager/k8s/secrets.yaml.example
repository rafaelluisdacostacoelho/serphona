# IMPORTANT: This is an example file. Do not commit actual secrets!
# Copy this file to secrets.yaml and fill in the actual values.
# Add secrets.yaml to .gitignore
#
# Create secrets via kubectl (recommended in CI/CD):
# kubectl create secret generic tenant-manager-secrets \
#   --from-literal=jwt-secret=<JWT_SECRET> \
#   --from-literal=redis-url=redis://:<REDIS_PASSWORD>@redis-master.redis.svc.cluster.local:6379/0 \
#   --from-literal=redis-password=<REDIS_PASSWORD> \
#   -n serphona
# kubectl create secret generic tenant-manager-db \
#   --from-literal=url=postgresql://<USER>:<PASSWORD>@postgresql.database.svc.cluster.local:5432/tenants?sslmode=require \
#   -n serphona

apiVersion: v1
kind: Secret
metadata:
  name: tenant-manager-secrets
  namespace: serphona
  labels:
    app: tenant-manager
    component: backend
type: Opaque
stringData:
  # Redis URL
  redis-url: "redis://:<REPLACE_WITH_REDIS_PASSWORD>@redis-master.redis.svc.cluster.local:6379/0"
  redis-password: "<REPLACE_WITH_REDIS_PASSWORD>"
  
  # JWT Secret for authentication
  jwt-secret: "CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE"
  
  # Optional: Stripe API key
  stripe-api-key: ""
  
  # Optional: SendGrid API key for emails
  sendgrid-api-key: ""

---
apiVersion: v1
kind: Secret
metadata:
  name: tenant-manager-db
  namespace: serphona
  labels:
    app: tenant-manager
    component: backend
type: Opaque
stringData:
  # DATABASE_URL is the only required DB setting
  url: "postgresql://tenant_manager:CHANGE_ME_STRONG_PASSWORD@postgresql.database.svc.cluster.local:5432/tenants?sslmode=require"
