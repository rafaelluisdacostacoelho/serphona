# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8082
GRPC_PORT=9092
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serphona_tenants?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFE=5m
DATABASE_AUTO_MIGRATE=true
DATABASE_MIGRATIONS_PATH=migrations

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=tenant-manager
KAFKA_TOPIC_PREFIX=serphona

# JWT Configuration (for authentication middleware)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ISSUER=serphona-auth
JWT_AUDIENCE=serphona-api
# For RS256 (optional): paste PEM public key below, keep empty to use HS256 (JWT_SECRET)
JWT_PUBLIC_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Observability
METRICS_ENABLED=true
METRICS_PORT=9091
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Observability extras (not yet wired):
# METRICS_PORT=9091
