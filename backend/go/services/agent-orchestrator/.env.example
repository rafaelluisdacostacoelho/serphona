# ==============================================================================
# Agent Orchestrator Service - Environment Variables
# ==============================================================================

# HTTP Server Configuration
HTTP_ADDR=:8080
GIN_MODE=debug  # debug, release

# Redis Configuration (Session Storage)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=  # Optional: sk-ant-your-anthropic-key

# Database Configuration (for Agent Repository - Future)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serphona_agents?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=serphona_agents
DB_SSLMODE=disable

# Tools Gateway Integration (Future)
TOOLS_GATEWAY_URL=http://localhost:8085

# Kafka Configuration (Event Publishing - Future)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=agent-orchestrator
KAFKA_TOPICS=agents.events,conversations.events

# Observability
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Session Configuration
SESSION_TTL_HOURS=24
SESSION_MAX_MESSAGES=100

# Agent Configuration
AGENT_MAX_CONCURRENT_SESSIONS=100
AGENT_DEFAULT_MODEL=gpt-4-turbo
AGENT_DEFAULT_TEMPERATURE=0.7
AGENT_DEFAULT_MAX_TOKENS=2000
