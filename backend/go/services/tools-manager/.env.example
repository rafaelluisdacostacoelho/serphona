# Tools Manager - MVP scaffold
SERVER_HOST=0.0.0.0
SERVER_PORT=8087
ENV=development

# Observability
METRICS_PATH=/metrics
HEALTH_PATH=/health
READY_PATH=/ready

# Database
DATABASE_URL=postgresql://tools_manager:change-me@localhost:5432/tools_manager?sslmode=disable

# Auth
JWT_SECRET=change-me-min-32-chars
JWT_ALLOWED_ALGS=HS256
JWT_ISSUER=https://auth.serphona.local
JWT_AUDIENCE=serphona
JWT_SERVICE_AUDIENCE=tools-manager
JWT_CLOCK_SKEW=30s
JWT_MAX_TOKEN_BYTES=4096
JWKS_URL=
JWKS_CACHE_TTL=5m
JWKS_ALLOWED_KIDS=
JWT_REQUIRED_SCOPES=tools:read
TENANT_CLAIM=tenant_id
