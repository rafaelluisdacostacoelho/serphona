# IMPORTANTE: Este é um template. NÃO commitar com valores reais!
# Copie para secrets.yaml e preencha com valores reais
# kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: tools-gateway-secrets
  namespace: serphona
type: Opaque
stringData:
  # Redis
  redis-url: "redis://:CHANGE_ME@redis-service:6379/0"
  
  # JWT
  jwt-secret: "CHANGE_ME_GENERATE_RANDOM_256BIT_KEY"
  
  # Optional: OAuth provider credentials (if using shared OAuth)
  oauth-client-id: ""
  oauth-client-secret: ""

---
apiVersion: v1
kind: Secret
metadata:
  name: tools-gateway-db
  namespace: serphona
type: Opaque
stringData:
  # DATABASE_URL is the only DB input required
  url: "postgresql://tools_user:CHANGE_ME@postgres-service:5432/serphona_tools?sslmode=require"
