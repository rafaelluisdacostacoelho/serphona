{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "9.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "9.0.0" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "Auth Gateway — Auth Metrics",
  "uid": "auth-gw-auth",
  "schemaVersion": 37,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "event",
        "label": "Event",
        "datasource": "Prometheus",
        "query": "label_values(auth_gateway_auth_events_total, event)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Auth failures (5m)",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(auth_gateway_auth_events_total{outcome=\"failure\"}[5m]))",
          "legendFormat": "failures/s",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Auth events by outcome",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(auth_gateway_auth_events_total{event=~\"$event\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "interval": ""
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Auth events by event/outcome",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by(event,outcome)(rate(auth_gateway_auth_events_total{event=~\"$event\"}[5m]))",
          "legendFormat": "{{event}} — {{outcome}}",
          "interval": ""
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Auth latency p95 by event",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,event)(rate(auth_gateway_auth_duration_seconds_bucket{event=~\"$event\",outcome=\"success\"}[5m])))",
          "legendFormat": "{{event}} p95",
          "interval": ""
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Auth latency p99 by event",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(le,event)(rate(auth_gateway_auth_duration_seconds_bucket{event=~\"$event\",outcome=\"success\"}[5m])))",
          "legendFormat": "{{event}} p99",
          "interval": ""
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "bargauge",
      "title": "Tenant missing by path (5m rate)",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by(path)(rate(auth_gateway_tenant_missing_total[5m]))",
          "legendFormat": "{{path}}",
          "interval": ""
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "displayMode": "gradient" }
    },
    {
      "type": "timeseries",
      "title": "Failure rate per event",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by(event)(rate(auth_gateway_auth_events_total{event=~\"$event\",outcome=\"failure\"}[5m])) / clamp_min(sum by(event)(rate(auth_gateway_auth_events_total{event=~\"$event\"}[5m])), 1e-6)",
          "legendFormat": "{{event}} failure ratio",
          "interval": ""
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    }
  ]
}
