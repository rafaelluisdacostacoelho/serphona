{
  "uid": "obs-traces",
  "title": "Serphona Traces & Logs",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": { "text": "Loki", "value": "Loki" }
      },
      {
        "name": "service",
        "type": "custom",
        "label": "service",
        "query": ".+,.*",
        "options": [
          { "text": ".+", "value": ".+" },
          { "text": ".*", "value": ".*" }
        ],
        "current": { "text": ".+", "value": ".+" }
      },
      {
        "name": "tenant",
        "type": "custom",
        "label": "tenant",
        "query": ".+,.*",
        "options": [
          { "text": ".+", "value": ".+" },
          { "text": ".*", "value": ".*" }
        ],
        "current": { "text": ".+", "value": ".+" }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "logs",
      "title": "Recent logs (by service/tenant)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=~\"$service\", tenant=~\"$tenant\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Loki logs by tenant",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{tenant=~\"$tenant\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 }
    }
  ]
}
